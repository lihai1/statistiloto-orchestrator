# Statistiloto-New environment configuration.
# Copy to `.env` and adjust. Never commit real secrets.

# ── PostgreSQL (shared) ──────────────────────────────────────
POSTGRES_USER=statistiloto
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=statistiloto

# ── Keycloak (auth) ──────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-prod
KEYCLOAK_REALM=statistiloto
# Internal URL used by services to fetch JWKS
KEYCLOAK_URL=http://auth:8080
# Public URL as seen by the browser (through Traefik)
KEYCLOAK_PUBLIC_URL=http://localhost/auth

# ── Social Login Providers ────────────────────────────────────
# Leave empty to disable social login (the buttons appear but won't work).
# Set both clientId and clientSecret to enable each provider.
#
# Google — https://console.cloud.google.com/apis/credentials
#   Create an OAuth 2.0 Client ID (Web application).
#   Authorized redirect URI:
#     http://localhost/auth/realms/statistiloto/broker/google/endpoint
#   (for prod: https://YOUR_DOMAIN/auth/realms/statistiloto/broker/google/endpoint)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps/
#   Create an app, add Facebook Login product.
#   Valid OAuth Redirect URI:
#     http://localhost/auth/realms/statistiloto/broker/facebook/endpoint
#   (for prod: https://YOUR_DOMAIN/auth/realms/statistiloto/broker/facebook/endpoint)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Traefik (proxy) ──────────────────────────────────────────
# Set to a real ACME-enabled domain for production TLS
TRAEFIK_DOMAIN=localhost

# ── Java BFF (server) ────────────────────────────────────────
SERVER_HTTP_PORT=8082
SERVER_PROFILE=dev
LOTTERY_GRPC_HOST=lottery
LOTTERY_GRPC_PORT=9090

# ── Go lottery-stats-server ──────────────────────────────────
LOTTERY_GRPC_PORT_GO=9090
LOTTERY_REST_PORT=8080
# Scraper schedule (cron). Default: 03:00 daily.
LOTTERY_SCRAPER_CRON=0 3 * * *
# When true, seed lottery_results from the bundled lotto.data on first boot.
LOTTERY_SEED_ON_BOOT=true

# ── Angular UI ───────────────────────────────────────────────
UI_HTTP_PORT=80

# ── Agent (optional overrides; not wired in docker-compose.yml by default) ──
# Free-tier LLM toggle boot default. When false, free-tier users get a canned
# response instead of an LLM call. Toggled at runtime via admin PUT /api/agent/free-llm.
# FREE_LLM_ENABLED=false
# Per-request LLM timeout (seconds). Default 300 (5 min for slow LLM inference).
LLM_REQUEST_TIMEOUT_SECONDS=300
